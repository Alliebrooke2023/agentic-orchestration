# driftrack/.env.example
# DriftRack reads plain environment variables. All are optional.
# PowerShell:  $env:STRIPE_SECRET_KEY = "sk_test_..."   then   python app.py

# ---- Payments (Stripe Checkout). Empty = simulated sandbox payments.
# Use a TEST key (sk_test_...) until you are ready to take real money.
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd

# ---- Email (password reset links). Needs DRIFTRACK_PUBLIC_URL too.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- AI listing descriptions through OpenRouter.
OPENROUTER_API_KEY=
# Tried left to right; switches on out-of-credit (402), rate limit (429) or errors.
DRIFTRACK_AI_MODELS=deepseek/deepseek-chat,meta-llama/llama-3.3-70b-instruct:free,openrouter/auto

# ---- Server
DRIFTRACK_HOST=127.0.0.1
DRIFTRACK_PORT=8750
# DRIFTRACK_DATA=C:\driftrack-data

# ---- Going public (set all three when the site is behind HTTPS)
# DRIFTRACK_PUBLIC_URL=https://shop.example.com
# DRIFTRACK_SECURE_COOKIES=1
# DRIFTRACK_TRUST_PROXY=1
