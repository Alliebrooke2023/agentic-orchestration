# driftrack/.env.example
# DriftRack reads plain environment variables. All are optional.
# PowerShell:  $env:OPENROUTER_API_KEY = "sk-or-..."   then   python app.py

# Turns on AI-written listing descriptions through OpenRouter.
OPENROUTER_API_KEY=

# Models are tried left to right. When one is out of credit (402), rate limited (429)
# or down, DriftRack switches to the next. If all fail it uses the built-in template.
# Use the exact model IDs shown on openrouter.ai/models (put your DeepSeek pick first).
DRIFTRACK_AI_MODELS=deepseek/deepseek-chat,meta-llama/llama-3.3-70b-instruct:free,openrouter/auto

DRIFTRACK_HOST=127.0.0.1
DRIFTRACK_PORT=8750
# DRIFTRACK_DATA=C:\driftrack-data
